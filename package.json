{
  "name": "chill-movie-apps-be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch api/index.ts",
    "build": "tsc",
    "start": "node ./dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && cross-env NODE_ENV=test TEST_DB_DISPOSABLE= RUN_DB_INTEGRATION= node --experimental-test-module-mocks --test ./dist/tests/index.test.js",
    "test:db": "npm run build && cross-env NODE_ENV=test TEST_DB_DISPOSABLE=1 RUN_DB_INTEGRATION=1 node --test ./dist/tests/integration/repositories.test.js",
    "knex": "knex --knexfile src/shared/config/knexfile.ts",
    "migrate": "npm run knex -- migrate:latest",
    "migrate:rollback": "npm run knex -- migrate:rollback",
    "migrate:list": "npm run knex -- migrate:list",
    "migrate:make": "npm run knex -- migrate:make",
    "seed": "npm run knex -- seed:run",
    "seed:make": "npm run knex -- seed:make"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfauzidr/chill-movie-apps-be.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mfauzidr/chill-movie-apps-be/issues"
  },
  "homepage": "https://github.com/mfauzidr/chill-movie-apps-be#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
